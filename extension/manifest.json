{
  "manifest_version": 3,
  "name": "VibeCheck",
  "version": "0.1.0",
  "description": "Filter negative content from your social feeds",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.reddit.com/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["src/content/twitter.ts"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "src/popup/index.html"
  }
}